========================================================= */

function loadExample(type){

    document.getElementById(
        "script"
    ).value =
        examples[type] ||
        "";

    updateCounters();

    setStatus(
        "Example loaded"
    );

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(text){

    return text
        .replaceAll(
            "&",
            "&amp;"
        )
        .replaceAll(
            "<",
            "&lt;"
        )
        .replaceAll(
            ">",
            "&gt;"
        )
        .replaceAll(
            '"',
            "&quot;"
        )
        .replaceAll(
            "'",
            "&#039;"
        );

}


/* =========================================================
   KEYBOARD SHORTCUTS
========================================================= */

document.addEventListener(
    "keydown",
    event => {

        if(
            event.ctrlKey &&
            event.key === "Enter"
        ){

            speakScript();

        }


        if(
            event.key === "Escape"
        ){

            stopSpeech();

        }

    }
);


/* =========================================================
   INITIALIZATION
========================================================= */

updateCounters();

applyStyle(
    "narrator"
);

</script>

